{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Razorcat playback spike",
  "version": "0.0.0",
  "identifier": "com.razorcat.spike.playback",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1430",
