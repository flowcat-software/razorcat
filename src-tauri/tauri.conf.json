{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Razorcat",
  "version": "../package.json",
  "identifier": "com.razorcat.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1430",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [],
    "security": {
      "csp": "default-src 'self'; connect-src 'self' ipc: http://ipc.localhost http://media.localhost; media-src 'self' http://media.localhost; img-src 'self' blob: data: http://media.localhost; style-src 'self' 'unsafe-inline'",
      "devCsp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "externalBin": ["binaries/ffmpeg", "binaries/gifski"],
    "resources": {
      "../LICENSE": "licenses/Razorcat-LICENSE.txt",
      "binaries/ffmpeg-LICENSE.txt": "licenses/ffmpeg-LICENSE.txt",
      "binaries/gifski-LICENSE.txt": "licenses/gifski-LICENSE.txt"
    },
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.ico"],
    "publisher": "Richard Podsada",
    "copyright": "Copyright © 2026 Richard Podsada",
    "license": "GPL-3.0-or-later",
    "category": "Video",
    "shortDescription": "A small, fast, precise video editor",
    "windows": {
      "webviewInstallMode": {
        "type": "downloadBootstrapper",
        "silent": true
      },
      "nsis": {
        "installMode": "currentUser",
        "installerHooks": "./windows/hooks.nsh",
        "installerIcon": "icons/icon.ico",
        "headerImage": "./windows/nsis-header.bmp",
        "sidebarImage": "./windows/nsis-sidebar.bmp"
      }
    }
  }
}
